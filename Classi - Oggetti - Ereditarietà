if __name__ == "__main__":
    print("--- Creazione dei Pazienti ---")
    paziente_1 = Paziente("Mario", "Rossi", 45, "PAZ001", "A+")
    paziente_1.aggiungi_patologia("Ipertensione")
    paziente_1.aggiungi_allergia("Penicillina")

    paziente_2 = Paziente("Anna", "Verdi", 29, "PAZ002", "0-")
    paziente_2.aggiungi_patologia("Asma")

    print(paziente_1)
    print(paziente_2)
    print("-" * 40)

    print("\n--- Creazione del Dottore ---")
    dottore = Dottore("Luigi", "Bianchi", 52, "Cardiologia", "DOC999", "Reparto Ovest")
    print(dottore)
    print("-" * 40)

    print("\n--- Gestione Visite e Cure ---")
    # Il dottore prende in cura i pazienti
    dottore.prendi_in_cura(paziente_1)
    dottore.prendi_in_cura(paziente_2)

    # Mostriamo la lista aggiornata dei pazienti del dottore
    dottore.mostra_pazienti()
