class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

class CircularLinkedList:
    def __init__(self):
        self.head = None

    def append(self, data):
        new_node = Node(data)
        if not self.head:
            self.head = new_node
            new_node.next = self.head
            return
        temp = self.head
        while temp.next != self.head:
            temp = temp.next
        temp.next = new_node
        new_node.next = self.head

    def insert_after(self, target, data):
        if not self.head:
            return
        temp = self.head
        while True:
            if temp.data == target:
                new_node = Node(data)
                new_node.next = temp.next
                temp.next = new_node
                return
            temp = temp.next
            if temp == self.head:
                break

    def remove(self, key):
        if not self.head:
            return
        curr = self.head
        prev = None
        while True:
            if curr.data == key:
                if prev:
                    prev.next = curr.next
                    if curr == self.head:
                        self.head = prev.next
                else:
                    if curr.next == self.head:
                        self.head = None
                    else:
                        temp = self.head
                        while temp.next != self.head:
                            temp = temp.next
                        self.head = curr.next
                        temp.next = self.head
                return
            prev = curr
            curr = curr.next
            if curr == self.head:
                break

    def traverse(self, steps):
        if not self.head:
            return
        nodes = []
        temp = self.head
        for _ in range(steps):
            nodes.append(temp.data)
            temp = temp.next
        print(f"Turni: {' -> '.join(nodes)}")

    def display(self):
        if not self.head:
            print("[]")
            return
        nodes = []
        temp = self.head
        while True:
            nodes.append(temp.data)
            temp = temp.next
            if temp == self.head:
                break
        print(f"Lista: {nodes}")

    def count(self):
        if not self.head:
            return 0
        c = 0
        temp = self.head
        while True:
            c += 1
            temp = temp.next
            if temp == self.head:
                break
        return c

team = CircularLinkedList()

team.append("alice")
team.append("bob")
team.append("carlo")

team.display()

team.traverse(6)

team.insert_after("bob", "diana")

team.display()

team.traverse(8)

team.remove("bob")

team.display()

team.traverse(6)

print(f"Analisti nel team: {team.count()}")